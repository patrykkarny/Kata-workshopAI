graph LR
  linkStyle default fill:#ffffff

  subgraph diagram ["[D1] Dynamic diagram: booking a specific room"]
    style diagram fill:#ffffff,stroke:#ffffff

    subgraph 4 ["Room with a View"]
      style 4 fill:#ffffff,stroke:#0b4884,color:#0b4884

      11["Synchronizacja Service (legacy ACL)<br/>[Container: TypeScript, NestJS]<br/>Board frame Synchronizacja:<br/>the only place that swaps<br/>files with legacy, both ways<br/>every 15 min. In: room pool<br/>we may sell, prices, non-pool<br/>bookings, check-ins and<br/>check-outs. Out: our pool<br/>bookings with guest data,<br/>check-ins / outs, payment<br/>pre-authorisation number.<br/>Numbered files, idempotent<br/>import, alert on a missing<br/>file; nightly full comparison<br/>(pool: we win, non-pool:<br/>legacy wins)."]
      style 11 fill:#438dd5,stroke:#2e6295,color:#ffffff
      13[("Shared Database<br/>[Container: PostgreSQL (managed)]<br/>Managed PostgreSQL, one<br/>schema per service; each<br/>service has its own DB user<br/>with access to its own schema<br/>only; replica in a second<br/>zone with automatic failover<br/>in 1-2 min; nightly backup +<br/>continuous log (point-in-time<br/>restore, 7 days).")]
      style 13 fill:#438dd5,stroke:#2e6295,color:#ffffff
      5["Guest Web App<br/>[Container: TypeScript, React PWA]<br/>Room photos and descriptions,<br/>availability; books a room<br/>type or a specific room;<br/>sends the guest to the<br/>payment operator's page."]
      style 5 fill:#438dd5,stroke:#2e6295,color:#ffffff
      7["Housekeeping Cart App<br/>[Container: Offline web app, IndexedDB]<br/>Ordered room list with guest<br/>wishes and defects; works<br/>offline, sends updates when<br/>Wi-Fi is back."]
      style 7 fill:#438dd5,stroke:#2e6295,color:#ffffff
      8["Rezerwacje Service<br/>[Container: TypeScript, NestJS]<br/>Board frame Rezerwacja + room<br/>availability and status: the<br/>only place that can take a<br/>room for a night (one<br/>transaction); holds the room<br/>10 min while the guest<br/>pre-authorises the payment at<br/>the payment operator,<br/>confirmed by webhook; never<br/>waits for legacy; computes<br/>when every hotel room is<br/>needed next."]
      style 8 fill:#438dd5,stroke:#2e6295,color:#ffffff
      9["Housekeeping Service<br/>[Container: TypeScript, NestJS]<br/>Board frames Housekeeping +<br/>Servis tech: one queue for<br/>cleaning and repairs,<br/>priority from when the room<br/>is needed next; API for cart<br/>devices. Keeps its own copy<br/>of room status and room<br/>needed-by (events from<br/>Rezerwacje), so it works on<br/>the last known state while<br/>Rezerwacje is down."]
      style 9 fill:#438dd5,stroke:#2e6295,color:#ffffff
    end

    1["Guest<br/>[Person]<br/>Views room photos and<br/>descriptions; books a room<br/>type or a specific room on<br/>web or mobile."]
    style 1 fill:#08427b,stroke:#052e56,color:#ffffff
    15["Reservations System (legacy)<br/>[Software System]<br/>Existing system: non-pool<br/>reservations, prices, stay<br/>settlement and refunds at<br/>checkout, cancellations,<br/>manager reports. No API, only<br/>file exchange. Blocks a room<br/>pool that only we sell."]
    style 15 fill:#999999,stroke:#6b6b6b,color:#ffffff
    17["Payment Operator<br/>[Software System]<br/>External payment operator:<br/>hosted payment page, card<br/>pre-authorisation at booking.<br/>We never see card data."]
    style 17 fill:#999999,stroke:#6b6b6b,color:#ffffff

